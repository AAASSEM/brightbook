# Server environment (development / production)
ENVIRONMENT=development

# Database connection URL (SQLite)
DATABASE_URL=sqlite:///../brightbook.db

# Gemini AI configuration (Get a key from Google AI Studio)
GEMINI_API_KEY=AIzaSy_YOUR_API_KEY_HERE

# JWT authentication security token (Generate a random string)
JWT_SECRET_KEY=YOUR_RANDOM_SECRET_KEY_HERE

# SMTP configuration for real email delivery (e.g. Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here
EMAIL_FROM=noreply@brightbook.app
